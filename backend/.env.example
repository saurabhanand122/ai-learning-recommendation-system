# Server Port
PORT=5000

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Clerk Auth Credentials
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenAI API Key (for ChatGPT recommendations)
OPENAI_API_KEY=sk-proj-...

# Google Gemini API Key (for the chat bot)
GEMINI_API_KEY=AIzaSy...

# Vercel deployment URLs (set these in Vercel if you need them available to the backend)
# FRONTEND_URL is the public frontend URL and can be used for CORS or callback configuration.
# BACKEND_URL is the public backend URL (your Vercel deployment domain).
# Example values:
# FRONTEND_URL=https://ai-learning-recommendation-system-f.vercel.app
# BACKEND_URL=https://ai-learning-recommendation-system-chi.vercel.app

